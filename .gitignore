# ─── Dependencies ────────────────────────────────────────────────
node_modules/
.pnp/
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# ─── Build & cache output ────────────────────────────────────────
dist/
build/
out/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# ─── Logs ────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Environment & secrets ───────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ─── Editor & IDE ────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ─── Operating system ────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Local warehouse data ────────────────────────────────────────
# Never commit real warehouse exports. This app is client-side only
# and no data should ever leave the operator's machine.
*.xlsx
*.xls
!docs/**/*.xlsx
data/
uploads/
